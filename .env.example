# ─────────────────────────────────────────────────────────────────────────────
# Cikka Backend — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit .env — only .env.example is version-controlled.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Pick ONE option below and uncomment it.

# Option A: Docker Compose (recommended — matches docker-compose.yml credentials)
DATABASE_URL="postgresql://cikka:cikka_dev@localhost:5432/cikka_dashboard?schema=public"

# Option B: Local Postgres via Homebrew (socket auth, no password)
# Replace <your-os-user> with the output of `whoami`
# DATABASE_URL="postgresql://<your-os-user>@localhost:5432/cikka_dashboard?schema=public"

# Option C: Postgres with explicit credentials
# DATABASE_URL="postgresql://<user>:<password>@localhost:5432/cikka_dashboard?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# HS256 signing secret for JWT.
# Generate a production secret with: openssl rand -hex 32
# The value below is for LOCAL DEV ONLY — change it before deploying.
JWT_SECRET="cikka-dev-secret-do-not-use-in-production-0000000000000000"
JWT_SELLER_SECRET="cikka-seller-dev-secret-0000000000000000"
JWT_CUSTOMER_SECRET="cikka-customer-dev-secret-0000000000000000"
JWT_EXPIRES_IN="7d"

# ── Setu Webhook Gateway ─────────────────────────────────────────────────────
SETU_BASIC_AUTH_USER="setu_user"
SETU_BASIC_AUTH_PASS="setu_secret_pass"
SETU_BEARER_TOKEN="setu_secret_bearer_token"
# Production IP whitelist (comma-separated IP addresses provided by Setu)
# SETU_ALLOWED_IPS="127.0.0.1,10.0.0.1"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the API will accept requests from.
# In dev this is the Vite dev server. In production set to your deployed frontend URL.
CORS_ORIGIN="http://localhost:5173"

# ── Decentro BaaS Payout Configuration ──────────────────────────────────────────────
DECENTRO_BASE_URL="https://in.staging.decentro.tech"
DECENTRO_CLIENT_ID="your_decentro_client_id"
DECENTRO_CLIENT_SECRET="your_decentro_client_secret"
DECENTRO_CORE_BANKING_MODULE_SECRET="your_decentro_core_banking_module_secret"
DECENTRO_PAYOUT_DEBIT_ACCOUNT="your_decentro_debit_account_number"


# ── Hubble Money SDK ────────────────────────────────────────────────────────
HUBBLE_ENV="staging"
HUBBLE_CLIENT_ID="cikka_staging_client_id"
HUBBLE_APP_SECRET="cikka_staging_app_secret"
# HUBBLE_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."


