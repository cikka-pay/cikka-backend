# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cikka_dashboard?schema=public"

# Long random string — used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

PORT=4000

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN="http://localhost:5173"
