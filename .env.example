# ─────────────────────────────────────────────────────────────────────────────
# Cikka Backend — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit .env — only .env.example is version-controlled.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Pick ONE option below and uncomment it.

# Option A: Docker Compose (recommended — matches docker-compose.yml credentials)
DATABASE_URL="postgresql://cikka:cikka_dev@localhost:5432/cikka_dashboard?schema=public"

# Option B: Local Postgres via Homebrew (socket auth, no password)
# Replace <your-os-user> with the output of `whoami`
# DATABASE_URL="postgresql://<your-os-user>@localhost:5432/cikka_dashboard?schema=public"

# Option C: Postgres with explicit credentials
# DATABASE_URL="postgresql://<user>:<password>@localhost:5432/cikka_dashboard?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# HS256 signing secret for JWT.
# Generate a production secret with: openssl rand -hex 32
# The value below is for LOCAL DEV ONLY — change it before deploying.
JWT_SECRET="cikka-dev-secret-do-not-use-in-production-0000000000000000"
JWT_SELLER_SECRET="cikka-seller-dev-secret-0000000000000000"
JWT_USER_SECRET="cikka-customer-dev-secret-0000000000000000"
JWT_EXPIRES_IN="7d"

# ── Setu Webhook Gateway ─────────────────────────────────────────────────────
SETU_BASIC_AUTH_USER="setu_user"
SETU_BASIC_AUTH_PASS="setu_secret_pass"
SETU_BEARER_TOKEN="setu_secret_bearer_token"
# Production IP whitelist (comma-separated IP addresses provided by Setu)
# SETU_ALLOWED_IPS="127.0.0.1,10.0.0.1"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the API will accept requests from.
# In dev this is the Vite dev server. In production set to your deployed frontend URL.
CORS_ORIGIN="http://localhost:5173"

# ── Hubble Money Configuration ────────────────────────────────────────────────
HUBBLE_ENV="staging"
HUBBLE_CLIENT_ID="cikka_staging_client_id"
HUBBLE_APP_SECRET="cikka_staging_app_secret"
HUBBLE_REST_CLIENT_SECRET="cikka_staging_rest_client_secret"
HUBBLE_MOCK_MODE="false"
# HUBBLE_SECRET=""
# HUBBLE_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# ── File Storage ─────────────────────────────────────────────────────────────
# STORAGE_PROVIDER: "railway" (Railway Bucket, production) or "local" (dev / tests).
# Defaults to "railway" when bucket credentials are present, otherwise "local"
# (files in LOCAL_UPLOADS_DIR, default /tmp/uploads, served from /api/files/<key>).
# STORAGE_PROVIDER="local"
# Railway Bucket credentials — on Railway, connect the bucket's Credentials preset
# (injects these exact names). To use a bucket from your machine, copy them here:
# BUCKET=""
# ACCESS_KEY_ID=""
# SECRET_ACCESS_KEY=""
# REGION=""
# ENDPOINT=""

# Public URL of this API, used to build absolute image URLs (<PUBLIC_BASE_URL>/api/files/<key>).
# On Railway this falls back to https://$RAILWAY_PUBLIC_DOMAIN when unset.
# PUBLIC_BASE_URL="http://localhost:4000"

# ── Runtime mode ─────────────────────────────────────────────────────────────
# "stub" (default) fakes OTP / KYB / Setu / InstantPay. Use "real" in production.
EXTERNAL_SERVICES_MODE="stub"
# NODE_ENV="production"

# ── Admin panel ──────────────────────────────────────────────────────────────
# Access codes for the admin gate. Outside production they default to the dev
# codes in src/config/env.ts; in production the gate stays closed until set.
# SUPER_ADMIN_ACCESS_CODE=""
# SELLER_ADMIN_ACCESS_CODE=""
# Admin tokens are signed with JWT_ADMIN_SECRET (falls back to JWT_SECRET).
# JWT_ADMIN_SECRET=""
# JWT_ADMIN_EXPIRES_IN="12h"
# Email/password admins are created with: npm run create-admin -- <email> "<Name>"

# ── OTP SMS (MSG91 primary, Fast2SMS fallback) ───────────────────────────────
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# FAST2SMS_API_KEY=""
# FAST2SMS_TEMPLATE_ID=""
# FAST2SMS_SENDER_ID=""

# ── Razorpay (checkout + Route payouts) ──────────────────────────────────────
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# ── Shipway logistics ────────────────────────────────────────────────────────
# SHIPWAY_USERNAME=""
# SHIPWAY_LICENSE_KEY=""

# ── InstantPay KYC ───────────────────────────────────────────────────────────
# INSTANTPAY_BASE_URL="https://sandbox.instantpay.in/v1"
# INSTANTPAY_CLIENT_ID=""
# INSTANTPAY_CLIENT_SECRET=""
# INSTANTPAY_AUTH_SECRET=""
# INSTANTPAY_ENCRYPTION_KEY=""
# INSTANTPAY_ENDPOINT_IP=""

# ── Setu payments + BBPS ─────────────────────────────────────────────────────
# SETU_BASE_URL="https://uat.setu.co"
# SETU_CLIENT_ID=""
# SETU_SECRET=""
# SETU_PRODUCT_INSTANCE_ID=""
# SETU_STRICT_AUTH="true"
# SETU_BBPS_BASE_URL="https://kms.setu.co/api/v2"
# SETU_BBPS_SCHEME_ID=""
# SETU_BBPS_SECRET=""
# SETU_BBPS_PRODUCT_INSTANCE_ID=""
# SETU_CHECK_STATUS_URL="https://<your-api-domain>/setu/v1/checkStatus"

# ── Resend email ─────────────────────────────────────────────────────────────
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL=""
# RESEND_TEST_RECIPIENT=""
