# ─────────────────────────────────────────────────────────────────────────────
# Cikka Backend — Environment Configuration Template
# Copy this file to .env and fill in the actual values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cikka_dashboard?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="cikka-dev-secret-do-not-use-in-production-0000000000000000"
JWT_SELLER_SECRET="cikka-seller-dev-secret-0000000000000000"
JWT_CUSTOMER_SECRET="cikka-customer-dev-secret-0000000000000000"
JWT_EXPIRES_IN="7d"

# ── Server & CORS ────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# ── External Services Mode (stub | real) ──────────────────────────────────────
EXTERNAL_SERVICES_MODE="stub"

# ── Setu Gateway & BBPS Configuration ──────────────────────────────────────
# Base URL provided by Setu (Sandbox: https://kms.setu.co/api/v2 or https://uat.setu.co)
SETU_BBPS_BASE_URL="https://kms.setu.co/api/v2"

# Outbound Credentials from Setu Developer Portal (Our Backend -> Setu)
SETU_BBPS_SCHEME_ID="your_setu_scheme_id_here"
SETU_BBPS_SECRET="your_setu_secret_here"
SETU_BBPS_PRODUCT_INSTANCE_ID="your_setu_product_instance_id_here"

# Webhook Authentication Credentials (Inbound Setu -> Our Backend)
SETU_BASIC_AUTH_USER="setu_user"
SETU_BASIC_AUTH_PASS="setu_secret_pass"
SETU_BEARER_TOKEN="setu_secret_bearer_token"
# Production IP whitelist (comma-separated IP addresses provided by Setu)
# SETU_ALLOWED_IPS="127.0.0.1"

# Callback Check Status URL (Configure in Setu Dashboard)
SETU_CHECK_STATUS_URL="http://localhost:4000/setu/v1/checkStatus"


