# ─────────────────────────────────────────────────────────────────────────────
# Cikka Backend — PRODUCTION environment template (Railway)
#
# Copy each variable into the backend service's Variables tab on Railway.
# Placeholders only — never commit real values. `${{...}}` are Railway
# reference variables and resolve at deploy time.
#
# Legend:  [required]  must be set or the app is insecure / broken in prod
#          [feature]   required only if you use that integration
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="production"                       # [required] enables Setu IP allowlist, hides 500 details
EXTERNAL_SERVICES_MODE="real"               # [required] "stub" fakes OTP / KYC / Setu / InstantPay
# PORT is injected by Railway — do not set it.

# Public URL of this API. Used to build image URLs (<PUBLIC_BASE_URL>/api/files/<key>).
# Falls back to https://$RAILWAY_PUBLIC_DOMAIN when unset; set it if you use a custom domain.
PUBLIC_BASE_URL="https://api.example.com"   # [required]

# Comma-separated origins of the seller dashboard / admin panel.
CORS_ORIGIN="https://seller.example.com"    # [required]

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="${{Postgres.DATABASE_URL}}"   # [required] Railway Postgres reference

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32   (use three DIFFERENT values)
JWT_SECRET="<generate>"                     # [required]
JWT_SELLER_SECRET="<generate>"              # [required] seller dashboard tokens
JWT_USER_SECRET="<generate>"                # [required] mobile app tokens
JWT_EXPIRES_IN="7d"

# Admin panel gate codes — long random strings, not dictionary words.
SUPER_ADMIN_ACCESS_CODE="<generate>"        # [required]
SELLER_ADMIN_ACCESS_CODE="<generate>"       # [required]

# ── File storage (Railway Bucket) ────────────────────────────────────────────
# 1. In the Railway project: New → Bucket.
# 2. Bucket → Credentials tab → connect its variable preset to this backend service.
#    That injects BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION, ENDPOINT,
#    which the app reads directly. Equivalent explicit references
#    (replace "cikka-uploads" with your bucket's service name):
STORAGE_PROVIDER="railway"                  # [required] uploads are lost on redeploy without a bucket
BUCKET="${{cikka-uploads.BUCKET}}"
ACCESS_KEY_ID="${{cikka-uploads.ACCESS_KEY_ID}}"
SECRET_ACCESS_KEY="${{cikka-uploads.SECRET_ACCESS_KEY}}"
REGION="${{cikka-uploads.REGION}}"
ENDPOINT="${{cikka-uploads.ENDPOINT}}"
# S3_FORCE_PATH_STYLE="true"                # only if the Credentials tab says path-style URLs

# ── OTP SMS (MSG91) ──────────────────────────────────────────────────────────
MSG91_AUTH_KEY=""                           # [feature] seller + mobile OTP login
MSG91_TEMPLATE_ID=""

# ── Razorpay (mobile checkout + Route seller payouts) ────────────────────────
RAZORPAY_KEY_ID=""                          # [feature] live key: rzp_live_...
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""                  # [feature] MUST be set — code has a hardcoded default

# ── Shipway logistics ────────────────────────────────────────────────────────
SHIPWAY_USERNAME=""                         # [feature]
SHIPWAY_LICENSE_KEY=""

# ── InstantPay KYC (PAN / GSTIN / CIN / Aadhaar / bank / VPA) ────────────────
INSTANTPAY_BASE_URL="<production base URL from InstantPay>"   # default is the sandbox
INSTANTPAY_CLIENT_ID=""                     # [feature]
INSTANTPAY_CLIENT_SECRET=""
INSTANTPAY_AUTH_SECRET=""
INSTANTPAY_ENCRYPTION_KEY=""
INSTANTPAY_ENDPOINT_IP=""                   # outbound IP InstantPay allowlists (needs Railway static egress IP)

# ── Setu payments webhook (mobile app) ───────────────────────────────────────
SETU_BASE_URL="<production base URL from Setu>"               # default is UAT
SETU_CLIENT_ID=""                           # [feature]
SETU_SECRET=""
SETU_PRODUCT_INSTANCE_ID=""
SETU_BASIC_AUTH_USER="<generate>"           # credentials Setu uses to call our webhooks
SETU_BASIC_AUTH_PASS="<generate>"
SETU_BEARER_TOKEN="<generate>"
SETU_STRICT_AUTH="true"                     # reject webhook calls without credentials
SETU_ALLOWED_IPS=""                         # comma-separated IPs provided by Setu

# ── Setu BBPS (mobile bill payments) ─────────────────────────────────────────
SETU_BBPS_BASE_URL="<production base URL from Setu>"
SETU_BBPS_SCHEME_ID=""                      # [feature]
SETU_BBPS_SECRET=""
SETU_BBPS_PRODUCT_INSTANCE_ID=""
SETU_CHECK_STATUS_URL="https://api.example.com/setu/v1/checkStatus"   # default is localhost

# ── Hubble Money (mobile rewards) ────────────────────────────────────────────
HUBBLE_ENV="production"                     # [feature]
HUBBLE_CLIENT_ID=""
HUBBLE_APP_SECRET=""
HUBBLE_SECRET=""
HUBBLE_REST_CLIENT_SECRET=""
HUBBLE_RSA_PRIVATE_KEY=""                   # PEM, newlines as \n
HUBBLE_MOCK_MODE="false"

# ── Resend email ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""                           # [feature]
RESEND_FROM_EMAIL="Cikka <noreply@example.com>"
RESEND_TEST_RECIPIENT=""                    # set it — otherwise falls back to a hardcoded personal address
